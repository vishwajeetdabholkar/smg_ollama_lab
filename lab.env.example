# Copy to lab.env (setup.sh does this for you). Environment variables override these.

# The model every task uses. Small on purpose: this lab is about the gateway.
MODEL=qwen3:0.6b
# A second, different model for the multi-model exercise in Task 4.
MODEL_B=llama3.2:1b

# Ports (change them if something on your machine already uses one).
OLLAMA_A_PORT=11500
OLLAMA_B_PORT=11501
ADAPTER_A_PORT=11600
ADAPTER_B_PORT=11601
SMG_PORT=30100
SMG_METRICS_PORT=29100

# Ollama tuning, applied to every lab Ollama server started by labctl.py.
# Task 6 is about choosing these. Empty = Ollama's own default.
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_NUM_PARALLEL=
OLLAMA_FLASH_ATTENTION=
OLLAMA_KV_CACHE_TYPE=
OLLAMA_KEEP_ALIVE=30m
