# Task 10 - your production config. Edit the values, then run:  python capstone.py
# This starting point is deliberately naive. Beat its score.

# Which lab Ollama servers sit behind the gateway: a  or  a,b
WORKERS=a

# Ollama engine settings, applied to every worker (empty = Ollama default)
OLLAMA_NUM_PARALLEL=1
OLLAMA_FLASH_ATTENTION=
OLLAMA_KV_CACHE_TYPE=
OLLAMA_CONTEXT_LENGTH=8192

# Extra flags for `smg launch` (policy, admission control, retries, health checks, ...)
SMG_FLAGS=--policy round_robin
